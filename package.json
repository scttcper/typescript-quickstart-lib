{
  "name": "--libraryname--",
  "version": "0.0.0-placeholder",
  "description": "",
  "author": "--username-- <--email-->",
  "license": "MIT",
  "repository": "",
  "type": "module",
  "exports": {
    "default": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts"
  },
  "files": [
    "dist/src"
  ],
  "sideEffects": false,
  "keywords": [],
  "scripts": {
    "lint": "oxlint . && prettier --check . --experimental-cli",
    "lint:fix": "oxlint . --fix && prettier --write . --log-level=error --experimental-cli",
    "prepare": "pnpm run build",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=./junit.xml",
    "postinstall": "node ./setup.ts && pnpm install --ignore-scripts"
  },
  "devDependencies": {
    "@ctrl/oxlint-config": "1.2.1",
    "@eslint/compat": "1.3.2",
    "@sindresorhus/tsconfig": "8.0.1",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "del": "8.0.0",
    "eslint": "9.33.0",
    "inquirer": "12.9.3",
    "oxlint": "1.12.0",
    "prettier": "3.6.2",
    "replace-in-file": "8.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.14.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "release": {
    "branches": [
      "--main--"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "semi": true,
    "printWidth": 100,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^node:.*$",
      "^react",
      "<THIRD_PARTY_MODULES>",
      "^(@ctrl)(/.*|$)",
      "~/",
      "^\\.\\./(?!.*\\.css$)",
      "^\\./(?!.*\\.css$)(?=.*/)",
      "^\\./(?!.*\\.css$)(?!.*/)"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": false
  }
}
